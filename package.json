{
  "name": "coffee-pub-studio",
  "productName": "Coffee Pub Studio",
  "version": "0.2.1",
  "description": "Wraps any web page in a fixed-size Chromium window that OBS can capture as a source, optimized for FoundryVTT sessions but not exclusive to Foundry.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Coffee Pub",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build-info": "node scripts/write-build-info.js",
    "prestart": "npm run build-info",
    "start": "electron .",
    "predist": "npm run build-info",
    "dist": "electron-builder --mac",
    "dist:arm64": "npm run build-info && electron-builder --mac --arm64",
    "dist:x64": "npm run build-info && electron-builder --mac --x64",
    "dist:win": "npm run build-info && electron-builder --win --publish never",
    "pack": "npm run build-info && electron-builder --mac --dir",
    "check": "node --check src/main.js && node --check src/config.js && node --check src/parking.js && node --check src/obs.js && node --check src/automations.js && node --check src/youtube.js && node --check src/preload.js && node --check src/bar-preload.js && node --check src/dock-preload.js && node --check src/dock/dock.js && node --check src/control/control.js && node --check src/bar/bar.js"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "live.coffeepub.studio",
    "productName": "Coffee Pub Studio",
    "copyright": "Copyright © 2026 Coffee Pub",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Coffee Pub Studio needs the microphone if you use FoundryVTT audio/video chat inside the Game window.",
        "NSCameraUsageDescription": "Coffee Pub Studio needs the camera if you use FoundryVTT audio/video chat inside the Game window."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8"
  }
}
