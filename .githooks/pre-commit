#!/bin/sh
# Refuses a commit that contains secret-looking files or text. Runs automatically when
# core.hooksPath is .githooks (set once per clone: git config core.hooksPath .githooks).

bad=0

# 1. File names that must never be committed
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    secrets.php|*/secrets.php|*.sqlite|*.sqlite-*|*.sqlite3|.secret|*/.secret|*admin-password.txt|*dev-admin-login.txt|.htpasswd|*/.htpasswd|*.pem|*.key|*.crt|data/*|*/data/*)
      echo "BLOCKED: $f looks like a secret or live data file."; bad=1 ;;
  esac
done

# 2. Secret-looking values in the added lines (this hook and the admin tool are skipped: they name these patterns)
hits=$(git diff --cached -U0 --no-color -- . ':(exclude).githooks' ':(exclude)tools/set-admin.php' \
  | grep '^+' | grep -v '^+++' \
  | grep -E 'admin_hash.{1,3}[[:space:]]*=>[[:space:]]*.[^[:space:],)]|github_token.{1,3}[[:space:]]*=>[[:space:]]*.[^.]|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|client_secret.{0,2}[[:space:]]*[:=]|apr1[$][A-Za-z0-9./]{8}|[$]2y[$][0-9]{2}[$][A-Za-z0-9./]{50,}' \
  | grep -v 'usesomesillystring')
if [ -n "$hits" ]; then
  echo "BLOCKED: staged changes contain secret-looking text:"
  echo "$hits" | cut -c1-120 | head -10
  bad=1
fi

if [ "$bad" -ne 0 ]; then
  echo ""
  echo "Nothing was committed. Remove the secret (or unstage the file with: git restore --staged <file>) and try again."
  exit 1
fi
exit 0
